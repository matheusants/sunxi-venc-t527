 module_platform_driver(cedrus_driver);
 
+/*
+ * (M14) Optional VE mod clock override. When 0 (default) the per-variant
+ * mod_rate from cedrus_variant is applied (600 MHz on T527). When non-zero
+ * this rate is requested instead — useful to validate the silicon ceiling
+ * above the conservative BSP value. Read at probe time only. Pass with
+ *   modprobe sunxi_cedrus clk_hz=720000000
+ * or
+ *   /etc/modprobe.d/sunxi-cedrus.conf : options sunxi_cedrus clk_hz=720000000
+ */
+unsigned long cedrus_clk_hz_override;
+EXPORT_SYMBOL_GPL(cedrus_clk_hz_override);
+module_param_named(clk_hz, cedrus_clk_hz_override, ulong, 0444);
+MODULE_PARM_DESC(clk_hz, "Override VE mod clock rate in Hz (0 = use variant default)");
+
