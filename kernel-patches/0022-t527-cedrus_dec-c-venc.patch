--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -22,6 +22,13 @@
 #include "cedrus_dec.h"
 #include "cedrus_hw.h"
 
+#include <linux/atomic.h>
+#include <linux/semaphore.h>
+
+extern struct semaphore sunxi_ve_sem;
+extern atomic_t cedrus_dec_inflight;
+extern void cedrus_dec_watchdog_start(struct cedrus_dev *dev);
+
 void cedrus_device_run(void *priv)
 {
 	struct cedrus_ctx *ctx = priv;
@@ -29,6 +36,15 @@
 	struct cedrus_run run = {};
 	struct media_request *src_req;
 
+	/* Claim the shared VE engine — blocks until a running encode ends. */
+	down(&sunxi_ve_sem);
+	/*
+	 * Mark decode as in-flight so cedrus_irq's stale-ctx path knows
+	 * to release the sem we just claimed. Cleared in cedrus_irq
+	 * before up().
+	 */
+	atomic_set(&cedrus_dec_inflight, 1);
+
 	run.src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
 	run.dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
 
@@ -92,5 +108,13 @@
 	/* Defer request completion to IRQ handler (after HW finishes) */
 	ctx->current_req = src_req;
 
+	/*
+	 * Arm the IRQ watchdog before triggering the HW. If the VE silently
+	 * fails to assert its completion interrupt, the watchdog releases
+	 * sunxi_ve_sem and errors the buffer instead of leaving every other
+	 * consumer of the shared engine wedged in down().
+	 */
+	cedrus_dec_watchdog_start(dev);
+
 	dev->dec_ops[ctx->current_codec]->trigger(ctx);
 }
